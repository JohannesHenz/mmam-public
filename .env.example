# Port the HTTPS server listens on (default: 443)
PORT=443

# Optional: Postgres connection string (defaults to the docker-compose database)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/mmam

# Optional: override TLS certificate locations (default: ./certs/)
# TLS_KEY_PATH=./certs/key.pem
# TLS_CERT_PATH=./certs/cert.pem
