<div id="disruptions" class="card shadow-lg">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mt-1">Störungen</h5>
        <button type="button" class="btn-close" id="close-disruptions" aria-label="Close"></button>
    </div>
    <div class="card-body">
        <div class="filters mb-3">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="show-disruptions" checked>
                <label class="form-check-label" for="show-disruptions">Störungen anzeigen</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="show-elevator" checked>
                <label class="form-check-label" for="show-elevator">Aufzugsstörungen anzeigen</label>
            </div>
            <select class="form-select mt-2" id="line-filter" multiple>
                <!-- Will be populated dynamically -->
            </select>
            <select class="form-select mt-2" id="station-filter" multiple>
                <!-- Will be populated dynamically -->
            </select>
        </div>
        <div id="disruptions-list" class="list-group">
            <!-- Will be populated dynamically -->
        </div>
    </div>
</div>