<div id="settings" style="display: none">
    <div class="card shadow-lg m-3">
        <div class="card-header">
            <h5 class="mt-1">Map Settings</h5>
        </div>
        <div class="card-body">
            <form>
                <div class="input-group mb-3">
                    <span class="input-group-text" id="latitude-span">Latitude</span>
                    <input type="number" step="0.001" class="form-control" aria-describedby="latitude-span" id="latitude">
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text" id="longitude-span">Longitude</span>
                    <input type="number" step="0.001" class="form-control" aria-describedby="longitude-span" id="longitude">
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text" id="zoom-span">Zoom</span>
                    <input type="number" step="1" class="form-control" aria-describedby="zoom-span" id="zoom">
                </div>
                <div class="form-check mb-1">
                    <input class="form-check-input" type="checkbox" value="" id="zoom-lock">
                    <label class="form-check-label" for="zoom-lock">Zoom lock</label>
                </div>
                <div class="form-check mb-1">
                    <input class="form-check-input" type="checkbox" value="" id="pan-lock">
                    <label class="form-check-label" for="pan-lock">Pan lock</label>
                </div>
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button class="btn btn-danger" type="button" id="map-settings-reset">Reset</button>
                    <button class="btn btn-primary" type="button" id="map-settings-save">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
