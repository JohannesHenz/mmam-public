<!-- mmam/views/stop-info.ejs -->

<div id="stop-info-oebb" style="display: none">
    <div class="card shadow-lg" id="stop-info-oebb-settings">
        <!-- Similar structure to settings window -->
        <div class="card-header">
            <h5 class="mt-1">Stop Info ÖBB</h5>
        </div>
        <div class="card-body form-group">
            <form>
                <div class="input-group mb-3">
                    <span class="input-group-text" id="stop-id-span">Stop Name ÖBB</span>
                    <input type="text" class="form-control" aria-describedby="stop-id-span" placeholder="Enter stop name" id="stop-info-oebb-input" list="suggestions">
                    <datalist id="suggestions"></datalist>
                </div>
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button class="btn btn-primary" type="button" id="get-stop-oebb-info">Get Arrival Times</button>
                </div>
            </form>
        </div>
    </div>
</div>
